        "# Verificar si algún canal RGB quedó 'recortado' en 255 o 0\n",
        "recortado = any(c == 255 or c == 0 for c in pixel_despues)\n",
        "print(\"¿Algún canal quedó recortado en 0 o 255?:\", recortado)"
