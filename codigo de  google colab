        "import numpy as np\n",
        "from skimage import color, filters\n",
        "from PIL import Image\n",
        "\n",
        "img = Image.open(\"mi_imagen.png\")\n",
        "img_gray = color.rgb2gray(np.array(img))\n",
        "\n",
        "# Completa: threshold_otsu y binarizacion\n",
        "thresh = filters.threshold_otsu(img_gray)\n",
        "binary = img_gray > thresh\n",
        "\n",
        "prop_true = np.mean(binary)\n",
        "\n",
        "print(\"Umbral de Otsu calculado:\", thresh)\n",
        "print(\"Proporción de píxeles 'True':\", prop_true)"
